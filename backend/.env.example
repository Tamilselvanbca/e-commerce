# Everything from "Store" down can also be managed in Admin → Settings, which
# overrides these values (secrets are stored encrypted in the database).
# `npm run settings:import` copies the values set here into the admin panel.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://shop:shop@127.0.0.1:5434/shop
# Public URL of the Next.js storefront (used for CORS, emails and payment redirects)
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
# Express "trust proxy": hop count or preset list. The default trusts loopback and private networks.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# RUN_JOBS=true

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
STORE_NAME=My Store
STORE_SUPPORT_EMAIL=support@example.com
STORE_SUPPORT_PHONE=+91 98765 43210
# FSSAI licence/registration number shown in the site footer (leave empty to hide)
FSSAI_LICENSE_NO=
CURRENCY=INR
# Amounts in paise: 4900 = Rs 49, 99900 = Rs 999
SHIPPING_FEE=4900
FREE_SHIPPING_THRESHOLD=99900
# Deliveries outside India (paise). Threshold 0 = never free. Default: Rs 1,999, free above Rs 14,999
INTERNATIONAL_SHIPPING_FEE=199900
INTERNATIONAL_FREE_SHIPPING_THRESHOLD=1499900
ORDER_PAYMENT_TIMEOUT_MINUTES=30
STORE_TIMEZONE=Asia/Kolkata
LOW_STOCK_THRESHOLD=5

# ---------------------------------------------------------------------------
# Auth (OTP)
# ---------------------------------------------------------------------------
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-me-to-a-long-random-string
# Encrypts the secrets saved in Admin → Settings (defaults to a key derived from OTP_SECRET).
# Set it in production and keep it safe: if it changes, secrets saved in the panel must be re-entered.
SETTINGS_ENCRYPTION_KEY=
# console (dev: code is logged) | msg91 | twilio | twilio_verify (Twilio Verify sends and checks the code)
OTP_PROVIDER=console
# Development only: include the OTP in the API response so you can log in without SMS
OTP_EXPOSE_IN_RESPONSE=true
DEFAULT_COUNTRY_CODE=91
# Comma separated phone numbers that become admins when they log in
ADMIN_PHONES=9999999999
SESSION_TTL_DAYS=30
# MSG91 (template must be DLT approved and contain ##OTP##)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
# Twilio Verify message format (company name = the Verify service's friendly name):
#   HJd2847507a6104c1622eaccf1f949af7d  Your {name} verification code is: {code}. This code will expire in {ttl} minutes.
#   HJ3694769091271a301c5873c6849932b3  {code} is your verification code for {name}. This code will expire in {ttl} minutes.
#   HJ152393dff43d3a2c1554ab0f28291dbe  Your {name} verification code is: {code}. This code will expire in {ttl} minutes. Don't share this code with anyone; our employees will never ask for the code.
#   HJ4d9c5db569029bedab5b28ab79f4cc8d  {code} is your verification code for {name}.
TWILIO_VERIFY_TEMPLATE_SID=
# SMS customers on order confirmed / processing / shipped / delivered / cancelled (uses TWILIO_FROM or messaging service)
ORDER_SMS_ENABLED=false

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Razorpay (Dashboard > Settings > API Keys; webhook: POST {API_URL}/api/webhooks/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (Developers > API keys; webhook: POST {API_URL}/api/webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: adds a simulated "Test payment" gateway
ENABLE_MOCK_PAYMENTS=true

# ---------------------------------------------------------------------------
# Email (Nodemailer SMTP). Local dev uses Mailpit from docker-compose: http://localhost:8025
# SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<api key>
# Leave SMTP_HOST empty to only log emails.
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=My Store <no-reply@example.com>
# Receives new-order and bulk-enquiry alerts
ADMIN_NOTIFY_EMAIL=owner@example.com

# ---------------------------------------------------------------------------
# Image storage: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN/CloudFront base URL for images, e.g. https://cdn.example.com
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Shipping: manual | shiprocket
# ---------------------------------------------------------------------------
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# Business WhatsApp number with country code, digits only (enables "Order on WhatsApp" buttons)
WHATSAPP_NUMBER=919876543210
# Optional WATI: notify the business on WhatsApp when a bulk enquiry arrives
WATI_API_ENDPOINT=
WATI_API_TOKEN=
WATI_TEMPLATE_NAME=
WATI_NOTIFY_NUMBER=
