# URL of the Express backend, as reachable from the Next.js server.
# Used for /api and /uploads rewrites (read at build time) and server-side data fetching.
BACKEND_URL=http://localhost:4000

# Public URL of the site, used for the sitemap and robots.txt.
SITE_URL=http://localhost:3000

# Shown only if the backend is unreachable when rendering.
NEXT_PUBLIC_STORE_NAME=My Store
