# Environment variables for GoDaddy Node.js Hosting. Set them in the hosting UI
# (Settings -> Environment variables / Secrets), never in an uploaded .env file.

# --- Database: nothing to set --------------------------------------------------
# The app uses GoDaddy's built-in managed MySQL. The platform sets DB_HOST, DB_PORT,
# DB_NAME, DB_USER and DB_PASSWORD itself; tables are created on the first start.
# Do not set DATABASE_URL here (it is ignored while DB_HOST is set; delete any old one).

# --- Required -----------------------------------------------------------------
# The public address of the store (used in emails, payment redirects and links).
FRONTEND_URL=https://norukutheeni.in
# Two long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep copies: if SETTINGS_ENCRYPTION_KEY changes, secrets saved in Admin -> Settings must be re-entered.
OTP_SECRET=
SETTINGS_ENCRYPTION_KEY=
# Mobile number(s) that become admins when they log in, comma separated.
ADMIN_PHONES=9876543210
# Login codes by SMS (production refuses the development "console" provider).
OTP_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Optional starting values (all editable later in Admin -> Settings) --------
STORE_NAME=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
WHATSAPP_NUMBER=
# Receives new-order and bulk-enquiry alerts.
ADMIN_NOTIFY_EMAIL=

# --- Set automatically by server.js (override only if you know you need to) ---
# NODE_ENV=production
# EMAIL_TRANSPORT=godaddy            (GoDaddy's mail gateway; SMTP is blocked on the platform)
# CLIENT_IP_HEADER=cf-connecting-ip  (visitor IP from GoDaddy's CDN, for rate limits)
# UPLOAD_DIR=<app>/public/assets/uploads  (kept between deployments)
